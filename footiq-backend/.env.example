# Required — obtain from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# CORS — set to your Vercel frontend URL (comma-separated if multiple)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional — paths default to ./chroma_db and ./data relative to working directory
CHROMA_PATH=./chroma_db
DATA_DIR=./data
